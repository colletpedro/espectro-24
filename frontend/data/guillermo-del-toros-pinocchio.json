        {
          "tema": "Pinóquio irritante e personagem desagradável",
          "mencoes_aproximadas": 10,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "O protagonista é descrito como insuportável, egoísta e malcriado, com uma voz estridente que contribui para a antipatia.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Músicas ruins e mal executadas",
          "mencoes_aproximadas": 9,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "As canções são criticadas como fracas, sem graça e desnecessárias, muitas vezes parecendo diálogos com ritmo ou letras infantis.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Tom sombrio e deprimente excessivo",
          "mencoes_aproximadas": 8,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "O clima é percebido como sombrio, depressivo e angustiante, sem equilíbrio, o que torna a experiência desagradável.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Design visual e animação feios ou perturbadores",
          "mencoes_aproximadas": 8,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "Apesar da técnica impressionante, o visual é considerado feio, perturbador ou sem vida, com personagens de aparência desagradável.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Enredo confuso e mal desenvolvido",
          "mencoes_aproximadas": 8,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "A história é vista como mal construída, com subtramas mal elaboradas e desenvolvimento fraco, resultando em uma narrativa sem foco.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        }
