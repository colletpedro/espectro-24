      "temas": [
        {
          "tema": "Duração excessiva e ritmo arrastado",
          "mencoes_aproximadas": 18,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "O filme é muito longo e tem um ritmo lento, com cenas que se arrastam e uma sensação de que a história poderia ser contada em menos tempo.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Estenótipo do negro mágico e racismo",
          "mencoes_aproximadas": 12,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "O personagem negro é retratado de forma submissa e infantilizada, servindo apenas para beneficiar os brancos ao redor, o que reforça um estereótipo racista e problemático.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Sentimentalismo forçado e manipulação emocional",
          "mencoes_aproximadas": 10,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "O filme tenta a todo custo arrancar lágrimas do espectador, mas essa emotividade parece fabricada e pouco convincente, soando piegas.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Personagens unidimensionais e roteiro fraco",
          "mencoes_aproximadas": 9,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "Os personagens são superficiais e mal desenvolvidos, e a trama se mostra inconsistente, com subtramas irrelevantes e falta de profundidade.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Superestimado e supervalorizado",
          "mencoes_aproximadas": 8,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "O filme é exaltado como um clássico, mas não justifica tanta aclamação; parece haver uma superestimação exagerada em torno dele.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Crítica à representação da pena de morte e do sistema prisional",
          "mencoes_aproximadas": 7,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "A abordagem da pena de morte e do sistema carcerário é simplista e enganosa, retratando os guardas como bem-intencionados e ignorando a brutalidade estrutural.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        }
      ],
      "observacao_geral": "As reviews negativas deste grupo destacam principalmente a duração excessiva e o ritmo lento, além de apontarem o estereótipo racial do negro mágico e o sentimentalismo forçado. A insatisfação também recai sobre personagens rasos, roteiro fraco e a percepção de que o filme é superestimado.",
      "idioma_invalido": false,
      "escopo_suspeito": false,
