          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "Várias pessoas apontam que a história quase não avança, que não há desenvolvimento dos personagens e que o filme parece vazio, dependendo de repetições e voltas ao passado.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Descaracterização do Arthur Fleck",
          "mencoes_aproximadas": 15,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "Muitos fãs do longa original sentem que o protagonista perdeu a complexidade e a essência que o tornavam interessante, transformando-se em alguém irreconhecível e sem profundidade.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Ritmo lento e tédio",
          "mencoes_aproximadas": 12,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "Várias pessoas dizem que o filme se arrasta, com cenas longas e paradas que não prendem a atenção, levando ao tédio e até ao abandono da sala antes do fim.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Personagem Harley Quinn subutilizada",
          "mencoes_aproximadas": 10,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "Parte do público reclama que a personagem de Lady Gaga tem pouco destaque na trama, servindo mais como adorno do que como alguém com importância real para a história.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Desfecho insatisfatório",
          "mencoes_aproximadas": 8,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "Alguns espectadores ficaram decepcionados com o final, considerando-o sem impacto e incompatível com a grandiosidade esperada para o personagem.",
