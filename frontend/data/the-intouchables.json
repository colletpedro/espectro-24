        {
          "tema": "Clichês e previsibilidade",
          "mencoes_aproximadas": 18,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "A trama é previsível e repleta de lugares-comuns, com uma estrutura de histórias infantis que não surpreende em momento algum.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Misoginia e piadas problemáticas",
          "mencoes_aproximadas": 12,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "As piadas machistas e o tratamento das mulheres como objetos são incômodos e tornam o filme datado.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Superestimado e sem profundidade",
          "mencoes_aproximadas": 10,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "O filme é superestimado e superficial, sem a profundidade que sua fama sugere.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Ritmo lento e falta de humor",
          "mencoes_aproximadas": 9,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "O ritmo é arrastado e as piadas não funcionam, tornando a experiência tediosa.",
