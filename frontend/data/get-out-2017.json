      "temas": [
        {
          "tema": "Previsibilidade da trama",
          "mencoes_aproximadas": 14,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "Várias reviews negativas afirmam que a história é totalmente previsível, com uma reviravolta óbvia que pode ser antecipada nos primeiros minutos, o que torna a experiência entediante.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Ritmo lento e falta de tensão",
          "mencoes_aproximadas": 12,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "Alguns espectadores consideram o filme excessivamente lento, com uma introdução longa e sem cenas que gerem medo ou tensão real, tornando a narrativa arrastada.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Filme superestimado",
          "mencoes_aproximadas": 10,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "Diversas reviews classificam a obra como superestimada, dizendo que não corresponde ao hype e que não entende o motivo de tanto elogio.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Crítica ao roteiro e à abordagem do racismo",
          "mencoes_aproximadas": 9,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "Algumas reviews criticam o roteiro por ser simplista, maniqueísta ou por não aprofundar bem o tema do racismo, resultando em uma mensagem pouco sutil.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Atuações irregulares",
          "mencoes_aproximadas": 7,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "Há comentários sobre atuações fracas ou deslocadas, com exceção de alguns atores como Daniel Kaluuya, que se destacam em meio a um elenco considerado irregular.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Final decepcionante",
          "mencoes_aproximadas": 6,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "O desfecho é frequentemente citado como ridículo, apressado ou mal explicado, comprometendo a impressão geral do filme.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        }
      ],
      "observacao_geral": "As reviews negativas analisadas destacam principalmente a previsibilidade, o ritmo lento e a falta de tensão, considerando o filme superestimado. Também criticam o roteiro e a abordagem do racismo, além de apontarem atuações irregulares e um final decepcionante.",
