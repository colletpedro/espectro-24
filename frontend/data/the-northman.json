      "temas": [
        {
          "tema": "Roteiro fraco e previsível",
          "mencoes_aproximadas": 21,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "A trama é uma repetição de clichês de vingança, sem surpresas ou desenvolvimento, tornando o desfecho óbvio desde o início.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Atuações ruins",
          "mencoes_aproximadas": 15,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "As atuações são artificiais e sem emoção, com destaque negativo para Nicole Kidman, que parece deslocada e com uma interpretação exagerada.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Ritmo lento e arrastado",
          "mencoes_aproximadas": 12,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "O filme se arrasta com uma duração excessiva e cenas desnecessárias, tornando a experiência cansativa e difícil de manter o interesse.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Diálogos artificiais e exagerados",
          "mencoes_aproximadas": 8,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "As falas são pomposas e grandiosas, com frases de efeito que soam forçadas e não condizem com conversas naturais.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Excesso de misticismo e ocultismo",
          "mencoes_aproximadas": 7,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "As referências a rituais e elementos sobrenaturais são vistas como exageradas e desconexas, prejudicando a imersão na história.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Desenvolvimento de personagens superficial",
          "mencoes_aproximadas": 7,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "Os personagens são unidimensionais, com motivações pouco exploradas, especialmente o protagonista, cuja sede de vingança não gera empatia.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        }
      ],
      "observacao_geral": "As reviews negativas criticam principalmente a narrativa previsível e sem profundidade, as atuações artificiais e o ritmo arrastado, embora reconheçam a beleza visual e a fotografia. Esse grupo demonstra uma forte decepção, especialmente dos fãs do diretor, e muitos abandonaram o filme antes do final.",
      "idioma_invalido": false,
      "escopo_suspeito": false
    },
