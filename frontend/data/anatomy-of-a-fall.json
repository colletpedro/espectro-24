          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "Alguns espectadores apontam que não conseguiram se importar com os protagonistas, o que enfraqueceu o impacto emocional da trama.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
