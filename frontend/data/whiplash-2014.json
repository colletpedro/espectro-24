      "temas": [
        {
          "tema": "Romantização do abuso e da toxicidade",
          "mencoes_aproximadas": 27,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "Várias reviews criticam a forma como o filme retrata a relação entre professor e aluno como uma apologia à violência psicológica e física, normalizando o sadismo e a humilhação em nome da excelência artística.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Personagens desagradáveis e sem profundidade",
          "mencoes_aproximadas": 20,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "Muitos espectadores consideram o protagonista e o mentor figuras irritantes, egoístas e unidimensionais, cujas motivações soam falsas ou exageradas, dificultando qualquer empatia.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Ritmo arrastado e experiência angustiante",
          "mencoes_aproximadas": 16,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "A narrativa é percebida como monótona e repetitiva, focada excessivamente em ensaios e sofrimento, o que gera ansiedade e tédio em vez de envolvimento.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Mensagem problemática e superficial",
          "mencoes_aproximadas": 14,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "As reviews apontam que o filme reforça tropos como o artista sofredor e a ideia de que a grandeza justifica o abuso, sem oferecer uma crítica ou reflexão mais profunda.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Retrato irreal e clichê do jazz",
          "mencoes_aproximadas": 9,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "Alguns espectadores familiarizados com jazz criticam a representação fantasiosa e hollywoodiana do meio musical, reduzindo a prática a um ritual de humilhação e sofrimento.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Excesso de hype e expectativas frustradas",
          "mencoes_aproximadas": 8,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "Diversas pessoas relatam que a obra não corresponde à aclamação que recebeu, sentindo-se decepcionadas após tantos elogios e considerando o resultado superestimado.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        }
      ],
      "observacao_geral": "As reviews negativas deste grupo destacam principalmente a romantização do abuso, personagens desagradáveis, ritmo angustiante e uma mensagem problemática. Muitos também criticam o hype excessivo e o retrato irreal do jazz, resultando em uma experiência frustrante para estes espectadores.",
