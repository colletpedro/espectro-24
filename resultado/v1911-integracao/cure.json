      "temas": [
        {
          "tema": "Ritmo extremamente lento",
          "mencoes_aproximadas": 20,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "O filme se arrasta de tal forma que duas horas parecem quatro, com cenas longas que não acrescentam nada e fazem o espectador perder a atenção.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Roteiro confuso e sem respostas",
          "mencoes_aproximadas": 15,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "A trama é tão cheia de mistérios sem explicação que ao final o espectador não entende o que realmente aconteceu, e a sensação é de que o filme foi feito para parecer profundo sem de fato ser.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Expectativa frustrada",
          "mencoes_aproximadas": 12,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "Muitos foram assistir influenciados pela alta nota e se decepcionaram, achando o filme supervalorizado e sem a genialidade que diziam ter.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Antagonista irritante",
          "mencoes_aproximadas": 10,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "O personagem misterioso que faz perguntas existenciais se torna tão repetitivo e irritante que dá vontade de interrompê-lo de qualquer jeito.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Cinematografia elogiada, mas insuficiente",
          "mencoes_aproximadas": 10,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "Embora a fotografia e o design de produção sejam belos e bem compostos, isso não compensa a narrativa fraca e o ritmo arrastado.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Atuações e personagens pouco cativantes",
          "mencoes_aproximadas": 8,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "Os atores parecem apáticos e não geram empatia, e os personagens são tão distantes que ninguém se importa com o destino deles.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        }
      ],
      "observacao_geral": "As reviews negativas criticam principalmente o ritmo arrastado, a falta de respostas do roteiro e a decepção com a alta expectativa criada pela fama do filme. Alguns reconhecem qualidades técnicas, mas consideram o resultado pretensioso e entediante.",
      "idioma_invalido": false,
      "escopo_suspeito": false
    },
