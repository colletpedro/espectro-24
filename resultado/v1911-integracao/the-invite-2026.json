      "temas": [
        {
          "tema": "Atuação de Olivia Wilde criticada",
          "mencoes_aproximadas": 10,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "Muitos espectadores consideram a atuação de Olivia Wilde exagerada e pouco natural, com expressões faciais forçadas e maneirismos que destoam do elenco.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Roteiro previsível e sem profundidade",
          "mencoes_aproximadas": 9,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "O enredo é considerado raso e previsível, sem desenvolvimento dos personagens ou reviravoltas interessantes, deixando a história monótona.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Humor falho e falta de comédia eficaz",
          "mencoes_aproximadas": 8,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "As piadas não funcionam e o tom cômico é forçado, resultando em poucos risos e muitas cenas constrangedoras.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Abordagem superficial de temas sexuais",
          "mencoes_aproximadas": 7,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "O filme trata de liberdade sexual e não-monogamia de maneira rasa e até mesmo incômoda, sem explorar de fato a eroticidade ou apresentar uma visão crítica.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Ritmo lento e tédio",
          "mencoes_aproximadas": 7,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "A narrativa se arrasta, com longos diálogos e pouca ação, fazendo o espectador sentir tédio e impaciência.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Trilha sonora irritante",
          "mencoes_aproximadas": 4,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "A trilha sonora é intrusiva e repetitiva, contribuindo para a sensação de artificialidade e desconforto.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        }
      ],
      "observacao_geral": "As reviews negativas apontam, em sua maioria, para uma atuação exagerada de Olivia Wilde, um roteiro previsível e sem profundidade, e um humor que não funciona. O filme também é criticado por abordar temas sexuais de forma superficial e por ter um ritmo lento e entediante.",
