      "temas": [
        {
          "tema": "Ritmo lento e duração excessiva",
          "mencoes_aproximadas": 30,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "O filme é longo demais, com muitas conversas e pouca ação, o que o torna cansativo e entediante.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Roteiro pretensioso e confuso",
          "mencoes_aproximadas": 12,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "A narrativa é complexa artificialmente, com cortes temporais que dificultam o entendimento e parecem mais uma tentativa de parecer inteligente.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Personagens femininas mal desenvolvidas",
          "mencoes_aproximadas": 10,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "As mulheres são reduzidas a estereótipos, aparecendo principalmente para cenas de nudez e sexo sem relevância para a trama.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Falta de consequências humanas da bomba",
          "mencoes_aproximadas": 8,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "O filme quase não mostra o impacto real dos bombardeios, concentrando-se apenas no dilema interno de Oppenheimer.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Excesso de foco em Oppenheimer como grande homem",
          "mencoes_aproximadas": 6,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "A história gira excessivamente em torno do gênio individual, ignorando o contexto coletivo e as vítimas.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Trilha sonora e técnica superestimadas",
          "mencoes_aproximadas": 5,
