      "temas": [
        {
          "tema": "Atuação de Olivia Wilde criticada",
          "mencoes_aproximadas": 12,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "Vários espectadores consideram a performance da atriz principal exagerada e pouco natural, destacando que ela se esforça demais e acaba prejudicando as cenas, principalmente quando comparada aos demais atores do elenco.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Roteiro raso e previsível",
          "mencoes_aproximadas": 10,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "O enredo é visto como superficial e sem profundidade, com reviravoltas óbvias e uma abordagem que não traz novidades, deixando a história monótona e sem sustento ao longo da projeção.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Falta de humor e comédia forçada",
          "mencoes_aproximadas": 8,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "Os espectadores apontam que o filme tenta ser engraçado, mas as piadas não funcionam e a comédia parece artificial, resultando em poucos momentos de riso genuíno e muita vergonha alheia.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Ritmo lento e tédio",
          "mencoes_aproximadas": 7,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "O longa é descrito como arrastado e entediante, com um ritmo que não engrena e cenas que se estendem sem necessidade, fazendo o público perder o interesse e checar o relógio.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Abordagem superficial de temas sexuais",
          "mencoes_aproximadas": 6,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "Há uma percepção de que o filme aborda sexo e relacionamentos abertos de maneira rasa e artificial, apenas falando sobre o assunto sem explorar a complexidade ou apresentar erotismo real, o que soa mais como provocação do que discussão.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Personagens irritantes e pouco cativantes",
          "mencoes_aproximadas": 6,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "Os personagens são considerados desagradáveis e difíceis de torcer por eles, com atitudes canastronas e diálogos que geram incômodo, tornando a experiência de assistir ao filme pouco agradável.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        }
      ],
      "observacao_geral": "As reviews negativas apontam que o filme sofre com atuações forçadas, especialmente de Olivia Wilde, roteiro raso e previsível, e uma comédia que não funciona. O ritmo lento, a abordagem superficial de temas sexuais e os personagens irritantes também são queixas frequentes, fazendo deste grupo uma recepção bastante desfavorável.",
      "idioma_invalido": false,
      "escopo_suspeito": false
    },
