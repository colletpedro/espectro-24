      "temas": [
        {
          "tema": "Violência excessiva e exploração",
          "mencoes_aproximadas": 15,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "O crítico aponta que o filme abusa de cenas chocantes e violentas, incluindo mortes e estupros, sem aprofundar as causas sociais, resultando em uma experiência cansativa e que parece explorar o sofrimento alheio como espetáculo.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Superestimado",
          "mencoes_aproximadas": 12,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "O espectador afirma que não entende a alta nota do filme, pois apesar de reconhecer alguns méritos técnicos, a história não o envolveu e ele não vê motivo para tanto elogio.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Roteiro fraco e desenvolvimento de personagens",
          "mencoes_aproximadas": 10,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "O comentarista critica o roteiro por ser previsível e cheio de clichês, e os personagens por serem superficiais, o que impede que o público crie conexão emocional com eles.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Narração e estrutura confusa",
          "mencoes_aproximadas": 8,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "O usuário reclama que a narração constante e os cortes rápidos tornam o filme cansativo e difícil de acompanhar, além de atrapalharem o desenvolvimento da história.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Estilo visual e direção artificiais",
          "mencoes_aproximadas": 6,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "O crítico acha a fotografia e a edição exageradas, com câmera tremida e filtros feios, dando um aspecto de comercial e afastando qualquer sensação de realismo.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        },
        {
          "tema": "Irrelevante ou desconectado da realidade",
          "mencoes_aproximadas": 5,
          "n_reviews_analisadas": 40,
          "exemplo_parafraseado": "O espectador considera o filme alienígena e glamorizado, mostrando uma visão estereotipada da favela que não corresponde à realidade, e acha que a história poderia se passar em qualquer lugar.",
          "mencoes_clampadas": false,
          "mencoes_valor_original": null,
          "aspas_removidas": false
        }
      ],
      "observacao_geral": "As reviews negativas apontam, em geral, que o filme é tecnicamente competente, mas falha em criar conexão emocional, sendo considerado superestimado e excessivamente violento. Muitos criticam a estética estilizada e a falta de aprofundamento social, sentindo-se mais impactados pelo desconforto do que pela reflexão.",
      "idioma_invalido": false,
